  reference_type   String          @db.VarChar(50)
  reference_id     BigInt?         @db.UnsignedBigInt
  reference_no     String?         @db.VarChar(100)
  debit            Decimal         @default(0.00) @db.Decimal(15, 2)
  credit           Decimal         @default(0.00) @db.Decimal(15, 2)
  balance          Decimal         @default(0.00) @db.Decimal(15, 2)
  date             DateTime        @default(dbgenerated("(curdate())")) @db.Date
  note             String?         @db.Text
  user_id          BigInt          @db.UnsignedBigInt
  created_at       DateTime        @default(now()) @db.Timestamp(0)

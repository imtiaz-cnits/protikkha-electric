  @@index([user_id])
}

model stock_movements {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  product_id       BigInt          @db.UnsignedBigInt
  business_unit_id BigInt?         @db.UnsignedBigInt
  movement_type    String          @db.VarChar(50)
  quantity         Decimal         @db.Decimal(15, 3)
  unit_price       Decimal         @default(0.00) @db.Decimal(15, 2)
  total_value      Decimal         @default(0.00) @db.Decimal(15, 2)
  reference_type   String          @db.VarChar(50)
  reference_id     BigInt?         @db.UnsignedBigInt
  reference_no     String?         @db.VarChar(100)
  stock_after      Decimal         @db.Decimal(15, 3)

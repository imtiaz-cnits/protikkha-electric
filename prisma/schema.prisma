  business_unit_id   BigInt?            @db.UnsignedBigInt
  transaction_type   String             @db.VarChar(50)
  amount             Decimal            @db.Decimal(15, 2)
  reference_type     String             @db.VarChar(50)
  reference_id       BigInt?            @db.UnsignedBigInt
  reference_no       String?            @db.VarChar(100)
  balance_after      Decimal            @db.Decimal(15, 2)
  date               DateTime           @default(dbgenerated("(curdate())")) @db.Date
  note               String?            @db.Text

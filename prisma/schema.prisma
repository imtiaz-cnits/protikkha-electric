// PHASE 4: EGG PRODUCTION & FLOCK MANAGEMENT MODELS
// ========================================================

model poultry_flocks {
  id                   BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  flock_code           String            @unique @db.VarChar(100)
  shed_name            String            @db.VarChar(150)
  breed                String            @db.VarChar(100)
  initial_chicks_count Int               @default(0)
  current_birds_count  Int               @default(0)
  housing_date         DateTime          @default(dbgenerated("(curdate())")) @db.Date
  status               String            @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "MOLTING", "CULLED"
  feed_consumed_kg     Decimal           @default(0.000) @db.Decimal(15, 3)
  total_expenses       Decimal           @default(0.00) @db.Decimal(15, 2)
  note                 String?           @db.Text
  user_id              BigInt            @db.UnsignedBigInt
  created_at           DateTime          @default(now()) @db.Timestamp(0)
  updated_at           DateTime          @default(now()) @db.Timestamp(0)
  users                users             @relation(fields: [user_id], references: [id])
  egg_collections      egg_collections[]

  @@index([user_id])
  @@index([status])
}

model egg_collections {
  id                    BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  collection_no         String                  @unique @db.VarChar(100)
  flock_id              BigInt                  @db.UnsignedBigInt
  collection_date       DateTime                @default(dbgenerated("(curdate())")) @db.Date
  total_collected       Int                     @default(0) // total eggs collected
  rejected_breakage     Int                     @default(0) // broken or cracked eggs
  accepted_quantity     Int                     @default(0) // total_collected - rejected_breakage
  allocated_expenses    Decimal                 @default(0.00) @db.Decimal(15, 2) // feed/medicine cost allocated
  cost_per_accepted_egg Decimal                 @default(0.0000) @db.Decimal(10, 4) // allocated_expenses / accepted_quantity
  status                String                  @default("COMPLETED") @db.VarChar(50) // "COMPLETED", "REVERSED"
  note                  String?                 @db.Text
  user_id               BigInt                  @db.UnsignedBigInt
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  updated_at            DateTime                @default(now()) @db.Timestamp(0)
  poultry_flocks        poultry_flocks          @relation(fields: [flock_id], references: [id])
  users                 users                   @relation(fields: [user_id], references: [id])
  egg_collection_grades egg_collection_grades[]

  @@index([flock_id])
  @@index([collection_date])
  @@index([user_id])
}

model egg_collection_grades {
  id               BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  collection_id    BigInt          @db.UnsignedBigInt
  product_id       BigInt          @db.UnsignedBigInt // product representing the egg grade
  grade_name       String          @db.VarChar(50) // "Grade A", "Grade B", "Grade C"
  quantity_pieces  Int             @default(0) // number of eggs in this grade
  tray_capacity    Int             @default(30) // standard 30 or custom 24
  trays_equivalent Decimal         @default(0.00) @db.Decimal(10, 2) // quantity_pieces / tray_capacity
  unit_cost        Decimal         @default(0.0000) @db.Decimal(10, 4)
  total_cost       Decimal         @default(0.00) @db.Decimal(15, 2)
  created_at       DateTime        @default(now()) @db.Timestamp(0)
  egg_collections  egg_collections @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  products         products        @relation(fields: [product_id], references: [id])

  @@index([collection_id])
  @@index([product_id])
  @@index([grade_name])
}

model egg_regradings {
  id                     BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  regrade_no             String   @unique @db.VarChar(100)
  source_product_id      BigInt   @db.UnsignedBigInt
  destination_product_id BigInt   @db.UnsignedBigInt
  quantity_pieces        Int      @default(0)
  date                   DateTime @default(dbgenerated("(curdate())")) @db.Date
  note                   String?  @db.Text
  user_id                BigInt   @db.UnsignedBigInt
  created_at             DateTime @default(now()) @db.Timestamp(0)
  source_product         products @relation("source_regrading", fields: [source_product_id], references: [id])
  destination_product    products @relation("destination_regrading", fields: [destination_product_id], references: [id])
  users                  users    @relation(fields: [user_id], references: [id])

  @@index([source_product_id])
  @@index([destination_product_id])
  @@index([user_id])
}

// ========================================================
// PHASE 5: FISH FARMING & POND MANAGEMENT MODELS
// ========================================================

model fish_ponds {
  id               BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  pond_code        String         @unique @db.VarChar(100)
  pond_name        String         @db.VarChar(150)
  area_decimal     Decimal        @default(0.00) @db.Decimal(8, 2)
  water_depth_feet Decimal        @default(5.00) @db.Decimal(5, 2)
  location         String?        @db.VarChar(255)
  status           String         @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "FALLOW", "MAINTENANCE"
  note             String?        @db.Text
  user_id          BigInt         @db.UnsignedBigInt
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @default(now()) @db.Timestamp(0)
  users            users          @relation(fields: [user_id], references: [id])
  fish_batches     fish_batches[]

  @@index([user_id])
  @@index([status])
}

model fish_species {
  id                   BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  species_name         String         @unique @db.VarChar(100)
  scientific_name      String?        @db.VarChar(150)
  default_culture_days Int            @default(180)
  created_at           DateTime       @default(now()) @db.Timestamp(0)
  updated_at           DateTime       @default(now()) @db.Timestamp(0)
  fish_batches         fish_batches[]
}

model fish_batches {
  id                         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  batch_no                   String             @unique @db.VarChar(100)
  pond_id                    BigInt             @db.UnsignedBigInt
  species_id                 BigInt             @db.UnsignedBigInt
  product_id                 BigInt?            @db.UnsignedBigInt // linked saleable fish product
  stocking_date              DateTime           @default(dbgenerated("(curdate())")) @db.Date
  fingerling_count           Int                @default(0)
  fingerling_unit_cost       Decimal            @default(0.00) @db.Decimal(10, 2)
  fingerling_total_cost      Decimal            @default(0.00) @db.Decimal(15, 2)
  total_mortality_count      Int                @default(0)
  current_fish_count         Int                @default(0)
  latest_avg_weight_g        Decimal            @default(0.00) @db.Decimal(10, 2)
  estimated_biomass_kg       Decimal            @default(0.000) @db.Decimal(15, 3)
  accumulated_feed_cost      Decimal            @default(0.00) @db.Decimal(15, 2)
  accumulated_other_expenses Decimal            @default(0.00) @db.Decimal(15, 2)
  total_harvested_count      Int                @default(0)
  total_harvested_kg         Decimal            @default(0.000) @db.Decimal(15, 3)
  total_harvested_cost       Decimal            @default(0.00) @db.Decimal(15, 2)
  status                     String             @default("ACTIVE") @db.VarChar(50) // "ACTIVE", "PARTIALLY_HARVESTED", "COMPLETED", "CLOSED"
  note                       String?            @db.Text
  user_id                    BigInt             @db.UnsignedBigInt
  created_at                 DateTime           @default(now()) @db.Timestamp(0)
  updated_at                 DateTime           @default(now()) @db.Timestamp(0)
  fish_ponds                 fish_ponds         @relation(fields: [pond_id], references: [id])
  fish_species               fish_species       @relation(fields: [species_id], references: [id])
  products                   products?          @relation(fields: [product_id], references: [id])
  users                      users              @relation(fields: [user_id], references: [id])
  fish_mortalities           fish_mortalities[]
  fish_samplings             fish_samplings[]
  fish_harvests              fish_harvests[]

  @@index([pond_id])
  @@index([species_id])
  @@index([product_id])
  @@index([status])
  @@index([user_id])
}

model fish_mortalities {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  batch_id        BigInt       @db.UnsignedBigInt
  mortality_count Int          @default(0)
  date            DateTime     @default(dbgenerated("(curdate())")) @db.Date
  reason          String?      @db.VarChar(255)
  user_id         BigInt       @db.UnsignedBigInt
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  fish_batches    fish_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  users           users        @relation(fields: [user_id], references: [id])

  @@index([batch_id])
  @@index([date])
  @@index([user_id])
}

model fish_samplings {
  id                   BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  batch_id             BigInt       @db.UnsignedBigInt
  sample_date          DateTime     @default(dbgenerated("(curdate())")) @db.Date
  sample_count         Int          @default(0)
  sample_weight_kg     Decimal      @default(0.000) @db.Decimal(10, 3)
  avg_weight_g         Decimal      @default(0.00) @db.Decimal(10, 2)
  estimated_biomass_kg Decimal      @default(0.000) @db.Decimal(15, 3)
  note                 String?      @db.Text
  user_id              BigInt       @db.UnsignedBigInt
  created_at           DateTime     @default(now()) @db.Timestamp(0)
  fish_batches         fish_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  users                users        @relation(fields: [user_id], references: [id])

  @@index([batch_id])
  @@index([sample_date])
  @@index([user_id])
}

model fish_harvests {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  harvest_no      String       @unique @db.VarChar(100)
  batch_id        BigInt       @db.UnsignedBigInt
  product_id      BigInt       @db.UnsignedBigInt
  harvest_type    String       @default("PARTIAL") @db.VarChar(50) // "PARTIAL", "FINAL"
  fish_count      Int          @default(0)
  total_weight_kg Decimal      @default(0.000) @db.Decimal(15, 3)
  avg_weight_kg   Decimal      @default(0.000) @db.Decimal(8, 3)
  cost_allocated  Decimal      @default(0.00) @db.Decimal(15, 2)
  cost_per_kg     Decimal      @default(0.00) @db.Decimal(10, 2)
  date            DateTime     @default(dbgenerated("(curdate())")) @db.Date
  note            String?      @db.Text
  user_id         BigInt       @db.UnsignedBigInt
  created_at      DateTime     @default(now()) @db.Timestamp(0)
  fish_batches    fish_batches @relation(fields: [batch_id], references: [id])
  products        products     @relation(fields: [product_id], references: [id])
  users           users        @relation(fields: [user_id], references: [id])

  @@index([batch_id])
  @@index([product_id])
  @@index([date])
  @@index([user_id])
}


// ==============================================================================
// PROTIKKHA ELECTRIC: ELECTRICAL SPECIFICATIONS & PACKAGING CONVERSIONS
// ==============================================================================

model electrical_specifications {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id         BigInt   @unique @db.UnsignedBigInt
  spec_type          String   @default("GENERAL") @db.VarChar(50) // CABLE, BREAKER, SWITCH, LIGHTING, CONDUIT, ACCESSORY, GENERAL
  conductor_material String?  @db.VarChar(50) // Copper, Aluminium
  cable_size         String?  @db.VarChar(50) // e.g. 1.5 rm, 2.5 rm, 4.0 rm, 6.0 rm
  core_count         Int?     @default(1)     // 1, 2, 3, 4
  voltage_grade      String?  @db.VarChar(50) // 450/750V, 600/1000V
  current_rating     String?  @db.VarChar(50) // 6A, 10A, 16A, 20A, 32A, 63A, 100A
  pole_type          String?  @db.VarChar(50) // 1P, 2P, 3P, 4P, 1P+N, 3P+N
  breaking_capacity  String?  @db.VarChar(50) // 3kA, 6kA, 10kA
  tripping_curve     String?  @db.VarChar(20) // B, C, D
  gang_module        String?  @db.VarChar(50) // 1-Gang, 2-Gang, 3-Gang, 4-Gang
  conduit_diameter   String?  @db.VarChar(50) // 16mm, 20mm, 25mm, 32mm, 0.75", 1.0"
  wattage            String?  @db.VarChar(50) // 5W, 9W, 12W, 18W, 24W, 50W
  color_temperature  String?  @db.VarChar(50) // Warm White 3000K, Neutral 4000K, Daylight 6500K
  warranty_months    Int?     @default(0)
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @db.Timestamp(0)

  products           products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([spec_type])
  @@index([cable_size])
  @@index([current_rating])
}

model packaging_conversions {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  product_id       BigInt   @db.UnsignedBigInt
  packaging_unit   String   @db.VarChar(50) // Reel, Coil, Box, Pack, Bundle, Carton
  base_unit        String   @db.VarChar(50) // Meter, Piece, Foot
  conversion_ratio Decimal  @db.Decimal(12, 4) // e.g. 1 Reel = 100.0000 Meters
  is_default       Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamp(0)
  updated_at       DateTime @default(now()) @db.Timestamp(0)

  products         products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, packaging_unit])
  @@index([product_id])
}

model warranty_records {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  product_id      BigInt     @db.UnsignedBigInt
  serial_number   String     @unique @db.VarChar(100)
  order_id        BigInt?    @db.UnsignedBigInt
  customer_id     BigInt?    @db.UnsignedBigInt
  purchase_date   DateTime?  @db.Date
  warranty_months Int        @default(12)
  expiry_date     DateTime   @db.Date
  status          String     @default("ACTIVE") @db.VarChar(50) // ACTIVE, EXPIRED, CLAIMED, REPLACED
  notes           String?    @db.Text
  created_at      DateTime   @default(now()) @db.Timestamp(0)
  updated_at      DateTime   @default(now()) @db.Timestamp(0)

  products        products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  orders          orders?    @relation(fields: [order_id], references: [id], onDelete: SetNull)
  customers       customers? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([product_id])
  @@index([order_id])
  @@index([customer_id])
  @@index([status])
  @@index([expiry_date])
}

model project_quotations {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  quotation_no       String            @unique @db.VarChar(100)
  project_name       String            @db.VarChar(255)
  client_name        String            @db.VarChar(255)
  client_phone       String?           @db.VarChar(50)
  client_address     String?           @db.Text
  contractor_name    String?           @db.VarChar(255)
  contractor_phone   String?           @db.VarChar(50)
  electrician_id     BigInt?           @db.UnsignedBigInt
  commission_percent Decimal           @default(0.00) @db.Decimal(5, 2)
  commission_amount  Decimal           @default(0.00) @db.Decimal(12, 2)
  subtotal           Decimal           @default(0.00) @db.Decimal(15, 2)
  discount_amount    Decimal           @default(0.00) @db.Decimal(15, 2)
  estimated_total    Decimal           @default(0.00) @db.Decimal(15, 2)
  status             String            @default("DRAFT") @db.VarChar(50) // DRAFT, SENT, APPROVED, CONVERTED_TO_ORDER, REJECTED
  validity_days      Int               @default(15)
  expiry_date        DateTime?         @db.Date
  order_id           BigInt?           @db.UnsignedBigInt
  note               String?           @db.Text
  user_id            BigInt            @db.UnsignedBigInt
  created_at         DateTime          @default(now()) @db.Timestamp(0)
  updated_at         DateTime          @default(now()) @db.Timestamp(0)

  quotation_items    quotation_items[]
  users              users             @relation(fields: [user_id], references: [id])
  orders             orders?           @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([user_id])
  @@index([order_id])
}

model quotation_items {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  quotation_id       BigInt             @db.UnsignedBigInt
  product_id         BigInt             @db.UnsignedBigInt
  item_name          String             @db.VarChar(255)
  packaging_unit     String?            @db.VarChar(50) // Reel, Box, Bundle, Meter
  quantity           Decimal            @db.Decimal(12, 2)
  unit_price         Decimal            @db.Decimal(12, 2)
  total_price        Decimal            @db.Decimal(15, 2)
  spec_notes         String?            @db.VarChar(255) // e.g. 2.5 rm red, 16A SP, 2-Gang
  created_at         DateTime           @default(now()) @db.Timestamp(0)

  project_quotations project_quotations @relation(fields: [quotation_id], references: [id], onDelete: Cascade)
  products           products           @relation(fields: [product_id], references: [id])

  @@index([quotation_id])
  @@index([product_id])
}

